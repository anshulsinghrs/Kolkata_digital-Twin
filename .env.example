# Server-side only. Never prefix anything here with VITE_.
PORT=8787
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Stage 3 Live Data Keys (Optional):
# 1. CPCB / data.gov.in API key for real-time ground air quality monitoring stations in Kolkata (Fort William, Victoria Memorial, etc.)
# Units are verified against official CPCB NAQI dashboard: µg/m³
DATAGOVIN_API_KEY=

# 2. TomTom Traffic Flow API key for real-time probe speeds across Howrah Bridge and Strand Road
TOMTOM_API_KEY=

# Note: Open-Meteo Weather, Open-Meteo Air Quality, and OpenSky Network Flights do not require API keys.
